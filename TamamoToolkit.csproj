<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net6.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!--强制复制nuget包中的DLL到生成目录-->
    <!--<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>-->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <!--发行版程序集信息-->
  <PropertyGroup>
    <Title>$(AssemblyName)</Title>
    <Authors>Yukari Mikaduki</Authors>
    <Copyright>Copyright (c) 2025-2027 Yukari Mikaduki. All rights reserved.</Copyright>
    <Version>2.4.0</Version>
    <Description>A collection of utilities integrated to facilitate daily development work.</Description>
    <PackageReadmeFile>README.en.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/YukariMikaduki/tamamo-toolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YukariMikaduki/tamamo-toolkit</RepositoryUrl>
  </PropertyGroup>

  <!--自动生成版本号-->
  <Target Name="SetBuildVersion" BeforeTargets="GetAssemblyVersion">
    <PropertyGroup>
      <_BuildVersionDays>$([System.DateTime]::Now.Date.Subtract($([System.DateTime]::new(2000, 1, 1))).Days)</_BuildVersionDays>
      <AssemblyVersion>$(Version).$(_BuildVersionDays)</AssemblyVersion>
      <FileVersion>$(AssemblyVersion)</FileVersion>
      <InformationalVersion>$(AssemblyVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.en.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="LICENSE">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
